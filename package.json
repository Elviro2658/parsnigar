{
  "name": "parsi-text-toolkit",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "ParsNegar — an open-source (MIT) Persian text normalization toolkit and browser demo.",
  "license": "MIT",
  "keywords": [
    "persian",
